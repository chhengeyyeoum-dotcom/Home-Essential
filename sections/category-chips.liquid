<nav class="chip-row" aria-label="Shop by category">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: '#' }}" class="chip {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
      {{ block.settings.label }}
    </a>
  {% else %}
    <a href="#" class="chip is-active">All candles</a>
    <a href="#" class="chip">Signature</a>
    <a href="#" class="chip">Diffusers</a>
    <a href="#" class="chip">Vessels &amp; refills</a>
    <a href="#" class="chip">Gifting edit</a>
  {% endfor %}
</nav>

{% schema %}
{
  "name": "Category chips",
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category chips",
      "blocks": [
        { "type": "chip", "settings": { "label": "All candles" } },
        { "type": "chip", "settings": { "label": "Signature" } },
        { "type": "chip", "settings": { "label": "Diffusers" } },
        { "type": "chip", "settings": { "label": "Vessels & refills" } },
        { "type": "chip", "settings": { "label": "Gifting edit" } }
      ]
    }
  ]
}
{% endschema %}
