{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icons', icon: 'search' %}
  Available: search, bag, heart, share, chevron-left, chevron-right, plus, trash, flame
{%- endcomment -%}

{%- case icon -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.6" y2="16.6"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l1 13H5L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.6-9.5-9.1C.8 7.6 2.4 4 6 4c2 0 3.4 1.1 4 2.2C10.6 5.1 12 4 14 4c3.6 0 5.2 3.6 3.5 6.9C19 15.4 12 20 12 20Z"/></svg>
  {%- when 'share' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.4"/><circle cx="17" cy="6" r="2.4"/><circle cx="17" cy="18" r="2.4"/><line x1="8.2" y1="10.8" x2="14.9" y2="7.2"/><line x1="8.2" y1="13.2" x2="14.9" y2="16.8"/></svg>
  {%- when 'chevron-left' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  {%- when 'chevron-right' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  {%- when 'trash' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M6 7l1 13h10l1-13"/><path d="M9 7V4h6v3"/></svg>
  {%- when 'flame' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c1 3-2 4-2 7a4 4 0 1 0 8 0c0-1-.5-2-1-2 .5 3-1 4-2 4 1-2-1-3-1-5 0-1.5.5-3 1-4-2 0-3 1-3 0Z"/></svg>
{%- endcase -%}
